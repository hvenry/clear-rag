# Ollama (default provider — nothing else required)
CLEARRAG_OLLAMA_URL=http://localhost:11434
CLEARRAG_CHAT_MODEL=llama3.2
CLEARRAG_EMBED_MODEL=nomic-embed-text

# The port every piece agrees on: uvicorn binds it, the Vite dev proxy targets it and
# compose publishes it. 8000 is deliberately avoided -- it is the default for Django,
# http.server and half the containers on a working laptop, so a collision there tends
# to answer with someone else's 404 rather than refuse the connection.
CLEARRAG_PORT=8010

# Where documents, vectors and traces live
CLEARRAG_WORKSPACE=./workspace

# Local inference tuning. num_ctx must comfortably exceed the pipeline's context budget
# (max_context_tokens, default 4096) plus the system prompt, question and answer --
# Ollama's own default is 4096, which truncates the instructions away silently.
CLEARRAG_NUM_CTX=8192
CLEARRAG_NUM_PREDICT=1024
# How long Ollama holds the model in memory between questions (default is 5m).
CLEARRAG_KEEP_ALIVE=30m
# Load models at startup instead of on the first question.
CLEARRAG_PRELOAD=true

# Optional: bring your own key. Leave blank to stay fully local.
CLEARRAG_OPENAI_API_KEY=
CLEARRAG_ANTHROPIC_API_KEY=
