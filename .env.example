# Ollama (default provider — nothing else required)
CLEARRAG_OLLAMA_URL=http://localhost:11434
CLEARRAG_CHAT_MODEL=llama3.2
CLEARRAG_EMBED_MODEL=nomic-embed-text

# Where documents, vectors and traces live
CLEARRAG_WORKSPACE=./workspace

# Optional: bring your own key. Leave blank to stay fully local.
CLEARRAG_OPENAI_API_KEY=
CLEARRAG_ANTHROPIC_API_KEY=
